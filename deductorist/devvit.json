{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "deductorist",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a new post",
        "description": "deductorist",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Admin: Nuclear Reset",
        "description": "Purge scheduler loops and restart",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/admin-nuclear-reset"
      },
      {
        "label": "Admin: Content Override",
        "description": "Change Seed/Date for this Post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/admin-content-override"
      },
      {
        "label": "Admin: Score Moderation",
        "description": "Remove cheating user from Leaderboard",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/admin-score-moderation"
      },
      {
        "label": "Admin: Manual Trigger",
        "description": "Force post next daily puzzle immediately",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/admin-manual-trigger"
      },
      {
        "label": "Admin: Global Leaderboard Reset",
        "description": "Wipe global leaderboards for a specific date",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/admin-dev-reset"
      }
    ]
  },
  "forms": {
    "adminDevResetForm": "/internal/form/admin-dev-reset-submit",
    "adminContentOverrideForm": "/internal/form/admin-override-submit",
    "adminScoreModerationForm": "/internal/form/admin-score-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "deductorist_dev"
  }
}